<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/bubbleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="60dp"
        android:background="@drawable/chat_bubble_sent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <!-- ImageView para mostrar la imagen enviada -->
        <ImageView
            android:id="@+id/ivMessageImageSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="250dp"
            android:maxHeight="250dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:layout_marginBottom="4dp"
            tools:srcCompat="@tools:sample/avatars"
            android:contentDescription="Imagen enviada" />

        <!-- Contenedor para el reproductor de audio enviado -->
        <LinearLayout
            android:id="@+id/layoutAudioPlayerSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginBottom="4dp"
            android:background="@drawable/audio_player_bg_sent"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btnPlayAudioSent"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_baseline_play_arrow_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:contentDescription="Reproducir audio"
                app:tint="@color/white" />
            <TextView
                android:id="@+id/tvAudioDurationSent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/lightGray"
                android:textSize="12sp"
                tools:text="0:25"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:visibility="visible"
            tools:text="Este es un mensaje de texto largo para probar el ancho máximo y cómo se envuelve."/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="end"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvEditedSent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(editado)"
                android:textSize="10sp"
                android:textColor="@color/lightGray"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/tvMessageTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/lightGray"
                android:textSize="10sp"
                tools:text="10:30 AM" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>