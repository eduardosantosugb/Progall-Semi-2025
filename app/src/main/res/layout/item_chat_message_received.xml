<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="8dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:id="@+id/bubbleLayoutReceived"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="60dp"
        android:background="@drawable/chat_bubble_received"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvMessageSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"
            tools:text="Otro Supervisor" />

        <!-- ImageView para mostrar la imagen recibida -->
        <ImageView
            android:id="@+id/ivMessageImageReceived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="250dp"
            android:maxHeight="250dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:layout_marginBottom="4dp"
            tools:srcCompat="@tools:sample/backgrounds/scenic"
            android:contentDescription="Imagen recibida" />

        <!-- Contenedor para el reproductor de audio recibido -->
        <LinearLayout
            android:id="@+id/layoutAudioPlayerReceived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginBottom="4dp"
            android:background="@drawable/audio_player_bg_received"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btnPlayAudioReceived"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_baseline_play_arrow_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:contentDescription="Reproducir audio"
                app:tint="@color/textColorPrimary" />
            <TextView
                android:id="@+id/tvAudioDurationReceived"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                tools:text="0:18"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessageContentReceived"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:textColor="@color/textColorPrimary"
            android:textSize="16sp"
            android:visibility="visible"
            tools:text="Este es un mensaje de respuesta del otro usuario para probar el ancho." />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="end"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvEditedReceived"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(editado)"
                android:textSize="10sp"
                android:textColor="@color/textColorSecondary"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/tvMessageTimestampReceived"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textColorSecondary"
                android:textSize="10sp"
                tools:text="10:32 AM" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>